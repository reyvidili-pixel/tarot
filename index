import React, { useState, useEffect, useCallback, useRef } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Link } from 'react-router-dom';
import { ArrowLeft } from 'lucide-react';

import { Button } from '@/components/ui/button';

import TarotCard from '@/components/game/TarotCard';
import PlayerAvatar from '@/components/game/PlayerAvatar';
import BiddingPanel from '@/components/game/BiddingPanel';
import TrickArea from '@/components/game/TrickArea';
import ScoreBoard from '@/components/game/ScoreBoard';
import RoundResultModal from '@/components/game/RoundResultModal';
import GameInfo from '@/components/game/GameInfo';

import {
  initializeGame,
  processBid,
  processChien,
  playCard,
  startNewRound,
  getAIBid,
  getAICardToPlay,
  getValidCards
} from '@/lib/gameEngine';

const PLAYER_NAMES = ['Vous', 'Marie', 'Pierre', 'Sophie'];
const MY_INDEX = 0;

export default function Game() {

  const [gameState, setGameState] = useState(() =>
    initializeGame(PLAYER_NAMES)
  );

  const [selectedCards, setSelectedCards] = useState([]);
  const [floatingCards, setFloatingCards] = useState([]);

  const aiTimerRef = useRef(null);

  const myHand = gameState.hands[MY_INDEX] || [];

  const isMyTurn = gameState.currentPlayer === MY_INDEX;
  const isMeTaker = gameState.taker === MY_INDEX;

  /* =========================
     IA LOGIC
  ========================= */

  useEffect(() => {

    if (gameState.phase === 'roundEnd') return;
    if (isMyTurn) return;

    aiTimerRef.current = setTimeout(() => {

      setGameState(prev => {

        if (prev.currentPlayer === MY_INDEX) return prev;

        if (prev.phase === 'bidding') {

          const aiHand = prev.hands[prev.currentPlayer];

          const currentHighest =
            prev.bids
              .filter(b => b.bid !== 'passe')
              .slice(-1)[0]?.bid || null;

          const aiBid = getAIBid(aiHand, currentHighest);

          return processBid(prev, prev.currentPlayer, aiBid);
        }

        if (prev.phase === 'playing') {

          const aiHand = prev.hands[prev.currentPlayer];

          const card = getAICardToPlay(
            aiHand,
            prev.currentTrick,
            prev.leadSuit
          );

          return playCard(prev, prev.currentPlayer, card);
        }

        return prev;
      });

    }, 850 + Math.random() * 500);

    return () => clearTimeout(aiTimerRef.current);

  }, [gameState.currentPlayer, gameState.phase, isMyTurn]);

  /* =========================
     CHIEN AUTO IA
  ========================= */

  useEffect(() => {

    if (gameState.phase === 'chien' && gameState.taker !== MY_INDEX) {

      setTimeout(() => {

        const takerHand = [
          ...gameState.hands[gameState.taker],
          ...gameState.chien
        ];

        const discardable = takerHand
          .filter(c =>
            c.type !== 'atout' &&
            c.type !== 'excuse'
          )
          .sort((a, b) =>
            (a.points || 0) - (b.points || 0)
          );

        const toDiscard = discardable.slice(0, 6).map(c => c.id);

        if (toDiscard.length === 6) {
          setGameState(prev =>
            processChien(prev, toDiscard)
          );
        }

      }, 1200);
    }

  }, [gameState.phase, gameState.taker]);

  /* =========================
     🎯 PLAY CARD FX
  ========================= */

  const handleCardPlay = useCallback((card) => {

    if (!isMyTurn || gameState.phase !== 'playing') return;

    const validCards = getValidCards(
      myHand,
      gameState.currentTrick,
      gameState.leadSuit
    );

    if (!validCards.find(c => c.id === card.id)) return;

    // 💥 VISUAL FX
    setFloatingCards(prev => [
      ...prev,
      {
        ...card,
        id: `${card.id}-${Date.now()}`
      }
    ]);

    setTimeout(() => setFloatingCards([]), 650);

    setGameState(prev => playCard(prev, MY_INDEX, card));

  }, [
    isMyTurn,
    gameState.phase,
    myHand,
    gameState.currentTrick,
    gameState.leadSuit
  ]);

  /* =========================
     ACTIONS
  ========================= */

  const handleBid = useCallback((bid) => {
    setGameState(prev => processBid(prev, MY_INDEX, bid));
  }, []);

  const handleChienSelect = useCallback((card) => {
    setSelectedCards(prev => {
      if (prev.includes(card.id)) return prev.filter(id => id !== card.id);
      if (prev.length >= 6) return prev;
      return [...prev, card.id];
    });
  }, []);

  const handleChienConfirm = useCallback(() => {
    setGameState(prev => processChien(prev, selectedCards));
    setSelectedCards([]);
  }, [selectedCards]);

  const handleNextRound = useCallback(() => {
    setGameState(prev => startNewRound(prev));
  }, []);

  /* =========================
     VALID CARDS
  ========================= */

  const validCardIds =
    gameState.phase === 'playing' && isMyTurn
      ? getValidCards(
          myHand,
          gameState.currentTrick,
          gameState.leadSuit
        ).map(c => c.id)
      : [];

  const displayHand = myHand;

  /* =========================
     RENDER
  ========================= */

  return (

    <div
      className="min-h-screen flex flex-col relative overflow-hidden text-white"
      style={{
        background: `
          radial-gradient(circle at center, rgba(40,90,60,0.25) 0%, rgba(15,25,18,0.92) 70%),
          linear-gradient(145deg, #5a3a1e 0%, #2d1a0d 100%)
        `
      }}
    >

      {/* LIGHT */}
      <div className="absolute inset-0 pointer-events-none"
        style={{
          background:
            'radial-gradient(circle at center, rgba(255,220,140,0.08), transparent 60%)'
        }}
      />

      {/* VIGNETTE */}
      <div className="absolute inset-0 pointer-events-none"
        style={{
          background:
            'radial-gradient(circle at center, transparent 40%, rgba(0,0,0,0.6) 100%)'
        }}
      />

      {/* HEADER */}
      <header className="relative z-10 flex items-center justify-between px-5 py-3 bg-black/30 backdrop-blur-md">

        <Link to="/">
          <Button variant="ghost" size="icon">
            <ArrowLeft />
          </Button>
        </Link>

        <h1 className="text-lg font-bold">Tarot Syloa</h1>

        <GameInfo
          phase={gameState.phase}
          trickCount={gameState.trickCount}
          takerBid={gameState.takerBid}
          takerName={
            gameState.taker !== null
              ? PLAYER_NAMES[gameState.taker]
              : null
          }
        />

      </header>

      {/* TABLE */}
      <div className="flex-1 relative z-10 flex flex-col">

        {/* CENTER */}
        <div className="flex-1 flex items-center justify-center relative">

          <AnimatePresence>

            {floatingCards.map(card => (
              <motion.div
                key={card.id}
                initial={{ scale: 0.6, y: 120, opacity: 0 }}
                animate={{ scale: 1.1, y: 0, opacity: 1 }}
                exit={{ scale: 0.8, opacity: 0 }}
                transition={{ duration: 0.4 }}
                className="absolute z-50"
              >
                <TarotCard card={card} disabled />
              </motion.div>
            ))}

          </AnimatePresence>

          <TrickArea
            currentTrick={gameState.currentTrick}
            myPlayerIndex={MY_INDEX}
          />

        </div>

        {/* HAND */}
        <div className="py-4 flex justify-center gap-2">

          {displayHand.map(card => {

            const isValid =
              gameState.phase === 'playing' &&
              isMyTurn &&
              validCardIds.includes(card.id);

            return (
              <motion.div
                key={card.id}
                whileTap={{ scale: 0.92 }}
                whileHover={{ y: -10, scale: 1.05 }}
              >
                <TarotCard
                  card={card}
                  disabled={!isValid}
                  onClick={() => handleCardPlay(card)}
                />
              </motion.div>
            );
          })}

        </div>

      </div>

      {/* ROUND END */}
      <AnimatePresence>
        {gameState.phase === 'roundEnd' && (
          <RoundResultModal
            result={gameState.roundResult}
            playerNames={PLAYER_NAMES}
            scores={gameState.scores}
            onNextRound={handleNextRound}
          />
        )}
      </AnimatePresence>

    </div>
  );
}
